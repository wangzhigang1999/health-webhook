# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被提交）

# webhook 访问令牌（必填）
AUTH_TOKEN=

# Caddy 在个人空间登录检查通过后注入，必须与手机上传 token 不同。
# 留空时 /reports 默认拒绝访问；不要将此值传到浏览器。
REPORT_ACCESS_KEY=

# 私有 OSS bucket
OSS_BUCKET=your-bucket
RAW_PREFIX=health/v2/raw/default

# ECS 实例 RAM 角色名（免密访问 OSS 用）
OSS_RAM_ROLE=

# OSS 端点：生产建议内网端点，省公网流量
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_REGION=cn-beijing

# 可选：显式 AK/SK/Token（不填则自动使用 ECS RAM 角色）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ACCESS_KEY_TOKEN=

# 有界待上传队列（已确认 OSS 保存的请求会立即清理本地副本）
DATA_DIR=/var/lib/dsh/workspace/health-data
OUTBOX_MAX_BYTES=268435456
MIN_DISK_FREE_BYTES=268435456
OSS_TIMEOUT_SECONDS=5

# HTTP 监听（Caddy 反代到 8081，仅本机即可）
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8081

# 单请求体上限（字节）
MAX_BODY_BYTES=2097152
