# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被提交）

# webhook 访问令牌（必填）
AUTH_TOKEN=

# Paimon 仓库（OSS），格式 oss://<bucket>/<path>
OSS_WAREHOUSE=oss://your-bucket/paimon/health

# ECS 实例 RAM 角色名（免密访问 OSS 用）
OSS_RAM_ROLE=

# OSS 端点：生产建议内网端点，省公网流量
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_REGION=cn-beijing

# 可选：显式 AK/SK/Token（不填则自动使用 ECS RAM 角色）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ACCESS_KEY_TOKEN=

# JSONL 兜底落盘目录
DATA_DIR=/var/lib/dsh/workspace/health-data

# HTTP 监听（Caddy 反代到 8081，仅本机即可）
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8081

# 单请求体上限（字节）
MAX_BODY_BYTES=2097152
