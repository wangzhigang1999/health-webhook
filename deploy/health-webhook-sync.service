[Unit]
Description=Health webhook -> Paimon batch sync
After=health-webhook.service

[Service]
Type=oneshot
WorkingDirectory=/var/lib/dsh/workspace/health-webhook
EnvironmentFile=/var/lib/dsh/workspace/health-webhook/.env
ExecStart=/var/lib/dsh/workspace/health-webhook/.venv/bin/python -m health_webhook.backfill
