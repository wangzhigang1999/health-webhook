[Unit]
Description=Retry pending health raw objects to OSS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/dsh/workspace/health-webhook-v2
EnvironmentFile=/var/lib/dsh/workspace/health-webhook/.env
ExecStart=/var/lib/dsh/workspace/health-webhook-v2/.venv/bin/python -m health_webhook.raw_store
Restart=on-failure
RestartSec=10
MemoryMax=192M
CPUQuota=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
